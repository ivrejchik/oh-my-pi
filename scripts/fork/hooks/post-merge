#!/usr/bin/env bash
# Enabled by `git config core.hooksPath scripts/fork/hooks`.
# Releases the new HEAD after a pull or merge (see scripts/fork/install.sh).
# `core.hooksPath` is shared by every worktree, including the release
# worktrees; only the main checkout releases. omp-sync runs install.sh itself.
if [ -n "${OMP_SYNC_ACTIVE:-}" ] ||
	[ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
	exit 0
fi
exec "$(git rev-parse --show-toplevel)/scripts/fork/install.sh"
